{
  "dashboard": {
    "id": 1420,
    "title": "E-Commerce Core Services Golden Signals Dashboard",
    "schemaVersion": 36,
    "timezone": "browser",
    "refresh": "10s",
    "templating": {
      "list": [
        {
          "name": "env",
          "type": "custom",
          "label": "Environment",
          "current": {
            "value": "production",
            "text": "production"
          },
          "options": [
            {
              "value": "production",
              "text": "production",
              "selected": true
            },
            {
              "value": "staging",
              "text": "staging",
              "selected": false
            },
            {
              "value": "development",
              "text": "development",
              "selected": false
            }
          ],
          "query": "production,staging,development"
        },
        {
          "name": "service",
          "type": "query",
          "label": "Service Name",
          "datasource": "Prometheus-Prod",
          "query": "label_values(http_requests_total{env=\"$env\"}, service)",
          "multi": true,
          "includeAll": true,
          "current": {
            "value": [
              "$__all"
            ],
            "text": "All"
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "P95 API Latency (ms)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{env=\"$env\", service=~\"$service\"}[5m])) by (le, service)) * 1000",
            "legendFormat": "{{service}} p95"
          }
        ],
        "transformations": [
          {
            "id": "labelsToFields",
            "options": {
              "mode": "columns"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 500
                },
                {
                  "color": "red",
                  "value": 1000
                }
              ]
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 15
            }
          }
        }
      },
      {
        "id": 2,
        "title": "CPU Utilization (%)",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", env=\"$env\"}[5m])) * 100)",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 75
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "HTTP Error Rate (%)",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_requests_total{status=~\"5..\", env=\"$env\", service=~\"$service\"}[5m])) / sum(rate(http_requests_total{env=\"$env\", service=~\"$service\"}[5m])) * 100",
            "legendFormat": "Error Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Order Processing Throughput (req/sec)",
        "type": "bargauge",
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (service) (rate(http_requests_total{env=\"$env\", service=~\"$service\"}[1m]))",
            "legendFormat": "{{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 100
                }
              ]
            }
          }
        }
      }
    ]
  },
  "question_code": "RTEL_Q11_E",
  "problem_code": "rtel_grafana_dashboard_dev",
  "exam_code": "p1d11"
}